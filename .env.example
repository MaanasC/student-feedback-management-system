# ==============================================================
# EduFeedback Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================

# Node Environment & Network Port
NODE_ENV=production
PORT=5000

# Database Connection (MongoDB)
# - Containerized Docker deployment (default): mongodb://mongo:27017/StudentFeedbackDB
# - Local bare-metal development: mongodb://127.0.0.1:27017/StudentFeedbackDB
# - MongoDB Atlas Cloud Cluster: mongodb+srv://<username>:<password>@cluster0.mongodb.net/StudentFeedbackDB?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/StudentFeedbackDB

# JWT Authentication Secrets
# Provide a secure random secret key for production token signing (minimum 32 characters)
JWT_SECRET=your_super_secret_random_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# Automated Seed Configuration
# For production deployments, set to false to prevent automatic seeding on boot.
# For fresh local testing, set to true to populate demo accounts if database is empty.
AUTO_SEED=false

# CORS Security & Allowed Origins
# Specify your exact production frontend URL (e.g. https://your-project.vercel.app).
# Additional explicit preview URLs can be appended as comma-separated values.
# Arbitrary or unrelated Vercel deployments are strictly rejected.
CLIENT_URL=https://your-project.vercel.app

# Frontend Client URLs (Optional - defaults to relative reverse proxy paths in production)
# On Vercel: VITE_API_URL=https://<your-render-backend>.onrender.com/api
# On Vercel: VITE_SOCKET_URL=https://<your-render-backend>.onrender.com
# VITE_API_URL=/api
# VITE_SOCKET_URL=/
