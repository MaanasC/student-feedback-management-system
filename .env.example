# ==============================================================
# EduFeedback Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================

# Node Environment & Network Port
NODE_ENV=production
PORT=5000

# Database Connection (MongoDB)
# - Containerized Docker deployment (default): mongodb://mongo:27017/StudentFeedbackDB
# - Local bare-metal development: mongodb://127.0.0.1:27017/StudentFeedbackDB
# - MongoDB Atlas Cloud Cluster: mongodb+srv://<username>:<password>@cluster0.mongodb.net/StudentFeedbackDB?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongo:27017/StudentFeedbackDB

# JWT Authentication Secrets
# Provide a secure random secret key for production token signing
JWT_SECRET=super_secret_university_feedback_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# Automated Seed Configuration
# When set to true, seeds default demonstration accounts and evaluation forms
# ONLY if the database is completely empty (never overwrites existing data)
AUTO_SEED=true

# Frontend Client URLs (Optional - defaults to relative reverse proxy paths in production)
# VITE_API_URL=/api
# VITE_SOCKET_URL=/
